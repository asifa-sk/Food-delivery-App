{
  "info": {
    "name": "Food App - Auth API",
    "_postman_id": "foodapp-auth-collection-v1",
    "description": "Authentication + Protected API tests — Food App backend (port 8081).\n\n── OTP HANDLING ─────────────────────────────────────────────\nDev mode (app.expose-otp-in-response=true):\n  Backend returns OTP inside json.otp → auto-captured.\n  Collection Runner completes unattended.\n\nProduction mode (property absent/false):\n  OTP is email-only. Runner halts at OTP steps via\n  pm.execution.setNextRequest(null). Set 'otp' manually.\n\n── SECURITY / AUTH TOKEN ────────────────────────────────────\nRequests 12-14 are PROTECTED and require authToken.\nThe token is auto-saved by steps 3, 4, 8, and 11.\nEach protected request validates token presence in its\npre-request script before firing.\n\n── TEST RELIABILITY ─────────────────────────────────────────\n• Status checks accept any 2xx (not just 200).\n• JSON parsing is guarded with try/catch.\n• Every script runs a 4xx/5xx error reporter block.\n• Negative tests assert absence of sensitive fields.\n\n── VARIABLES ────────────────────────────────────────────────\n  baseUrl   — backend root URL\n  testEmail — auto-generated per run\n  testPass  — initial password (reset after step 10)\n  otp       — auto-populated (dev) or set manually (prod)\n  authToken — auto-saved after login / OTP-verify steps\n  userId    — auto-saved after OTP verification\n\n── RUNNING ──────────────────────────────────────────────────\nCollection Runner: execute in order 1 → 14.\nProd mode halts at OTP steps — set 'otp', then resume.\n────────────────────────────────────────────────────────────",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  
  "variable": [
    { "key": "baseUrl",   "value": "http://localhost:8081", "type": "string" },
    { "key": "testEmail", "value": "",                      "type": "string" },
    { "key": "testPass",  "value": "Password@123",          "type": "string" },
    { "key": "testName",  "value": "Test User",             "type": "string" },
    { "key": "otp",       "value": "",                      "type": "string" },
    { "key": "authToken", "value": "",                      "type": "string" },
    { "key": "userId",    "value": "",                      "type": "string" }
  ],

  "item": [
    {
      "name": "1. Register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate a unique email per run to avoid duplicate conflicts",
              "const ts    = Date.now();",
              "const email = `testuser_${ts}@foodapp.com`;",
              "pm.collectionVariables.set('testEmail', email);",
              "",
              "// Clear stale OTP and token from any previous run",
              "pm.collectionVariables.set('otp', '');",
              "pm.collectionVariables.set('authToken', '');",
              "pm.collectionVariables.set('userId', '');",
              "",
              "console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');",
              "console.log('▶ [1. Register]');",
              "console.log('   email :', email);",
              "console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');"
            ]
          }
        },
        {       
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 400) {",
              "    let msg = pm.response.text();",
              "    try { msg = pm.response.json().message || msg; } catch(e) {}",
              "    console.error(` HTTP ${pm.response.code}: ${msg}`);",
              "}",
              "",
              "pm.test('Response status is 2xx', () => {",
              "    pm.expect(pm.response.code).to.be.within(200, 299);",
              "});",
              "pm.test('Response is JSON', () => { pm.response.to.be.json; });",
              "let json;",
              "try { json = pm.response.json(); }",
              "catch(e) { console.error(' JSON parse failed:', pm.response.text()); return; }",
              "",
              "pm.test('success flag is true', () => { pm.expect(json.success).to.be.true; });",
              "pm.test('message is non-empty', () => {",
              "    pm.expect(json.message).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('email matches registered email', () => {",
              "    pm.expect(json.email).to.eql(pm.collectionVariables.get('testEmail'));",
              "});",
              "pm.test('response does NOT expose password', () => {",
              "    pm.expect(json).to.not.have.property('password');",
              "});",
              "",
              "// ── OTP auto-capture ──────────────────────────────────────────",
              "if (json.otp) {",
              "    pm.collectionVariables.set('otp', json.otp);",
              "    pm.test('OTP auto-captured from response [DEV MODE]', () => {",
              "        pm.expect(json.otp).to.match(/^\\d{6}$/);",
              "    });",
              "    console.log(' OTP auto-captured:', json.otp);",
              "    console.log('   Collection Runner will proceed automatically.');",
              "} else {",
              "    console.warn(' OTP not in response (production mode).');",
              "    console.warn('  ACTION: Check your email, then set the');",
              "    console.warn('      \"otp\" variable in Collection Variables.');",
              "    console.warn('    TIP: Run \"2. Resend OTP\" if no email arrived.');",
              "    console.warn('   ⏸  Collection Runner will halt at \"3. Verify OTP\".');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{testName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPass}}\",\n  \"role\": \"CUSTOMER\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "2. Resend OTP  [utility – run if OTP email not received]",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = pm.collectionVariables.get('testEmail');",
              "if (!email) {",
              "    throw new Error('testEmail is not set. Run \"1. Register\" first.');",
              "}",
              "console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');",
              "console.log('▶ [2. Resend OTP]  email:', email);",
              "console.log('   Requesting a fresh OTP...');",
              "console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 400) {",
              "    let msg = pm.response.text();",
              "    try { msg = pm.response.json().message || msg; } catch(e) {}",
              "    console.error(` HTTP ${pm.response.code}: ${msg}`);",
              "}",
              "",
              "pm.test('Response status is 2xx', () => {",
              "    pm.expect(pm.response.code).to.be.within(200, 299);",
              "});",
              "pm.test('Response is JSON', () => { pm.response.to.be.json; });",
              "let json;",
              "try { json = pm.response.json(); }",
              "catch(e) { console.error(' JSON parse failed:', pm.response.text()); return; }",
              "",
              "pm.test('success flag is true', () => { pm.expect(json.success).to.be.true; });",
              "pm.test('message is non-empty', () => {",
              "    pm.expect(json.message).to.be.a('string').and.not.empty;",
              "});",
              "",
              "// ── OTP auto-capture (dev mode) ───────────────────────────────",
              "if (json.otp) {",
              "    pm.collectionVariables.set('otp', json.otp);",
              "    pm.test('New OTP auto-captured from response [DEV MODE]', () => {",
              "        pm.expect(json.otp).to.match(/^\\d{6}$/);",
              "    });",
              "    console.log(' New OTP auto-captured:', json.otp);",
              "} else {",
              "    console.warn(' OTP not in response. Check your email and set \"otp\" variable.');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/resend-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "resend-otp"] }
      }
    },
    {
      "name": "3. Verify OTP (Registration)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const otp   = pm.collectionVariables.get('otp')   || '';",
              "const email = pm.collectionVariables.get('testEmail') || '';",
              "",
              "console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');",
              "console.log('▶ [3. Verify OTP (Registration)]');",
              "console.log('   email:', email);",
              "",
              "if (!otp || otp.trim() === '') {",
              "    console.error(' HALT: otp variable is empty.');",
              "    console.error('   Set \"otp\" in Collection Variables → Variables tab,');",
              "    console.error('   then rerun from this request.');",
              "    // Stop the Collection Runner at this step",
              "    pm.execution.setNextRequest(null);",
              "} else {",
              "    console.log('   otp  :', otp);",
              "    console.log('    OTP is set — proceeding with verification.');",
              "}",
              "console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 400) {",
              "    let msg = pm.response.text();",
              "    try { msg = pm.response.json().message || msg; } catch(e) {}",
              "    console.error(` HTTP ${pm.response.code}: ${msg}`);",
              "}",
              "",
              "pm.test('Response status is 2xx', () => {",
              "    pm.expect(pm.response.code).to.be.within(200, 299);",
              "});",
              "pm.test('Response is JSON', () => { pm.response.to.be.json; });",
              "let json;",
              "try { json = pm.response.json(); }",
              "catch(e) { console.error('JSON parse failed:', pm.response.text()); return; }",
              "",
              "pm.test('success flag is true', () => { pm.expect(json.success).to.be.true; });",
              "",
              "pm.test('isVerified is true', () => { pm.expect(json.isVerified).to.be.true; });",
              "pm.test('token is a non-empty string', () => {",
              "    pm.expect(json.token).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('userId is present', () => { pm.expect(json.userId).to.exist; });",
              "pm.test('role is CUSTOMER', () => { pm.expect(json.role).to.eql('CUSTOMER'); });",
              "pm.test('response does NOT expose password', () => {",
              "    pm.expect(json).to.not.have.property('password');",
              "});",
              "",
              "// ── Auto-save credentials ─────────────────────────────────────",
              "if (json.token) {",
              "    pm.collectionVariables.set('authToken', json.token);",
              "    console.log(' authToken saved.');",
              "}",
              "if (json.userId) {",
              "    pm.collectionVariables.set('userId', String(json.userId));",
              "    console.log('userId saved:', json.userId);",
              "}",
              "// Clear OTP after use to prevent stale reuse",
              "pm.collectionVariables.set('otp', '');",
              "console.log(' otp variable cleared after use.');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"otp\": \"{{otp}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-otp"] }
      }
    },
