              "    pm.expect(json.token).to.not.exist;",
              "});",
              "",
              "console.log('Negative test passed — wrong password correctly rejected.');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
